+// Checksum of a compiled schema, ignoring the leading `__build_info` block.
+// __build_info records source file timestamps, which differ between the
+// machine that prebuilds the data and the device, so prebuilt prisms would
+// otherwise always be considered outdated.
+static uint32_t compute_schema_file_checksum(const path& schema_file) {
+  std::ifstream fin(schema_file.c_str(), std::ios::binary);
+  if (!fin) {
+    return Checksum(schema_file);
+  }
+  boost::crc_32_type crc;
+  std::string line;
+  bool in_build_info = false;
+  while (std::getline(fin, line)) {
+    if (!line.empty() && line[0] != ' ' && line[0] != '\t') {
+      in_build_info = line.rfind("__build_info:", 0) == 0;
+    }
+    if (!in_build_info) {
+      line.push_back('\n');
+      crc.process_bytes(line.data(), line.size());
+    }
+  }
+  return crc.checksum();
+}
